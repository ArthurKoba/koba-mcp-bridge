# Public URL served by your reverse proxy / Coolify.
SITE_URL=https://secrets.koba-nexus.ru

# Generate once and back up securely.
# openssl rand -hex 16
ENCRYPTION_KEY=

# Generate once and back up securely.
# openssl rand -base64 32
AUTH_SECRET=

POSTGRES_USER=infisical
POSTGRES_DB=infisical
POSTGRES_PASSWORD=

# Local bind used by the standalone compose deployment.
# In Coolify the service can instead be routed internally to port 8080.
INFISICAL_BIND_ADDRESS=127.0.0.1
INFISICAL_PORT=8080

TELEMETRY_ENABLED=false
