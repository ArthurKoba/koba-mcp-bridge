#!/bin/sh
set -eu

SHA="${1:-}"
case "$SHA" in
  ''|*[!0-9a-f]* ) echo "invalid sha" >&2; exit 2 ;;
esac
[ "${#SHA}" -eq 40 ] || { echo "invalid sha" >&2; exit 2; }

PROJECT_DIR=/srv/koba-mcp-bridge
IMAGE="ghcr.io/arthurkoba/koba-mcp-bridge:sha-$(printf '%s' "$SHA" | cut -c1-7)"

cd "$PROJECT_DIR"
docker pull "$IMAGE"
printf 'KOBA_MCP_IMAGE=%s\n' "$IMAGE" > .env.new
chmod 0644 .env.new
mv .env.new .env
KOBA_MCP_IMAGE="$IMAGE" docker compose up -d --no-deps bridge

echo "deployed $IMAGE"
