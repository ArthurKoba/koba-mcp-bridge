# Public hostname(s) accepted by the MCP HTTP transport.
# Exact hostnames and wildcard ports are supported by the MCP SDK.
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*
MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://[::1]:*

# GitHub OAuth transport. Provider-specific IDs/users/secrets live in Infisical
# under github/oauth and are resolved by convention at runtime.
OAUTH_ENABLED=false
OAUTH_BASE_URL=https://mcp.koba-nexus.ru

# Persist FastMCP OAuth client registrations and token state across redeploys.
# Mount this directory as persistent storage in production.
FASTMCP_HOME=/data/fastmcp

# OpenTelemetry defaults used by Docker Compose.
OTEL_SERVICE_NAME=koba-mcp-bridge
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Universal content-addressed file service.
FILE_ROOT=/files
FILE_UPLOAD_MAX_BYTES=8589934592
FILE_UPLOAD_CHUNK_BYTES=1048576
FILE_MAX_EXTRACT_FILES=20000
FILE_MAX_EXTRACT_BYTES=17179869184


# GitLab multi-profile connector.
# Profile metadata contains no secret token. Each profile references a runtime
# secret environment variable or an absolute mounted secret file.
GITLAB_PROFILES_FILE=/data/fastmcp/gitlab-profiles.json
GITLAB_PROFILES_JSON=
GITLAB_PROTECTED_BRANCHES=main,master

# Example secret referenced by a profile:
# GITLAB_TOKEN_GITLAB_COM_ARTHUR=<secret>
#
# Example GITLAB_PROFILES_JSON:
# [{"profile_id":"gitlab-com-arthur","base_url":"https://gitlab.com","auth_type":"private_token","token_env":"GITLAB_TOKEN_GITLAB_COM_ARTHUR"}]


# Central secrets provider. Provider credentials/config live below
# INFISICAL_BASE_PATH and are resolved by convention.
INFISICAL_HOST=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=prod
INFISICAL_BASE_PATH=/
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
# Optional file-based bootstrap instead of env values:
INFISICAL_CLIENT_ID_FILE=
INFISICAL_CLIENT_SECRET_FILE=
INFISICAL_VERIFY_TLS=true
INFISICAL_CA_FILE=

