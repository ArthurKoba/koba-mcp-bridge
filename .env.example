# Deployment.
MCP_BRIDGE_IMAGE=ghcr.io/arthurkoba/mcp-bridge:latest
GATEWAY_PORT=8092

# Public MCP edge.
MCP_ALLOWED_HOSTS=mcp.koba-nexus.ru,localhost:*,127.0.0.1:*
MCP_ALLOWED_ORIGINS=https://mcp.koba-nexus.ru
OAUTH_ENABLED=true
OAUTH_BASE_URL=https://mcp.koba-nexus.ru

# GitHub OAuth protecting the public MCP gateway.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_JWT_SIGNING_KEY=
GITHUB_OAUTH_ALLOWED_USERS=

# Account control plane. Generate CONTROL_PLANE_ENCRYPTION_KEY with Fernet.generate_key().
CONTROL_PLANE_URL=http://control-plane:8000
CONTROL_PLANE_TIMEOUT_SECONDS=10
CONTROL_PLANE_DATABASE_PATH=/control-plane/control-plane.sqlite3
CONTROL_PLANE_ENCRYPTION_KEY=
CONTROL_PLANE_SERVICE_TOKEN=
CONTROL_PLANE_ADMIN_USERNAME=admin
CONTROL_PLANE_ADMIN_PASSWORD=
CONTROL_PLANE_SESSION_SECRET=
CONTROL_PLANE_SESSION_HTTPS_ONLY=true

# Files data plane.
FILE_UPLOAD_MAX_BYTES=8589934592
FILE_UPLOAD_CHUNK_BYTES=1048576
FILE_MAX_EXTRACT_FILES=20000
FILE_MAX_EXTRACT_BYTES=17179869184

# Git provider policy.
GITHUB_AGENT_PROTECTED_BRANCHES=main,master
GITHUB_AGENT_REQUIRED_CHECKS=test,docker
GITHUB_AGENT_REQUIRED_REVIEWERS=
GITLAB_PROTECTED_BRANCHES=main,master
GITLAB_REGISTRY_CACHE_TTL_SECONDS=60

# Runtime-specific optional settings.
CURL_BINARY=
ANALYSIS_SCHEMA_CACHE_TTL_SECONDS=30

# Internal service URL overrides. Normally Docker DNS defaults are used.
GITHUB_URL=http://github:8000/mcp
GITLAB_URL=http://gitlab:8000/mcp
FILES_URL=http://files:8000/mcp
CURL_URL=http://curl:8000/mcp
ANALYSIS_URL=http://analysis:8000/mcp
GHIDRA_MCP_URL=http://bridge:8081/mcp
