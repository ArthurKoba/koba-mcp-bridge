# Public hostname(s) accepted by the MCP HTTP transport.
# Exact hostnames and wildcard ports are supported by the MCP SDK.
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*
MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://[::1]:*

# GitHub OAuth. Keep disabled until all required production values are configured.
OAUTH_ENABLED=false
OAUTH_BASE_URL=https://mcp-bridge.koba-nexus.ru
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_JWT_SIGNING_KEY=
OAUTH_ALLOWED_GITHUB_USERS=ArthurKoba

# Persist FastMCP OAuth client registrations and token state across redeploys.
# Mount this directory as persistent storage in production.
FASTMCP_HOME=/data/fastmcp

# OpenTelemetry defaults used by Docker Compose.
OTEL_SERVICE_NAME=koba-mcp-bridge
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Protected integration policy. New neutral names take precedence over legacy
# GITHUB_AGENT_* aliases when both are set.
GITHUB_PROTECTED_BRANCHES=main,master
GITHUB_REQUIRED_CHECKS=test,docker

# Optional per-repository override. JSON keys are full repository names and
# values are exact GitHub check-run names. Falls back to GITHUB_REQUIRED_CHECKS.
# Example:
# GITHUB_REQUIRED_CHECKS_BY_REPOSITORY={"ArthurKoba/koba-mcp-bridge":["test","docker","same-repository-head"],"ArthurKoba/ghidra-mcp":["Build Status"]}
GITHUB_REQUIRED_CHECKS_BY_REPOSITORY=
