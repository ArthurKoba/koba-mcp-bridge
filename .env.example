# Public MCP edge.
MCP_ALLOWED_HOSTS=mcp.koba-nexus.ru,localhost:*,127.0.0.1:*
MCP_ALLOWED_ORIGINS=https://mcp.koba-nexus.ru
OAUTH_ENABLED=true
OAUTH_BASE_URL=https://mcp.koba-nexus.ru
FASTMCP_HOME=/data/fastmcp

# Files data plane.
FILE_ROOT=/files
FILE_UPLOAD_MAX_BYTES=8589934592
FILE_UPLOAD_CHUNK_BYTES=1048576
FILE_MAX_EXTRACT_FILES=20000
FILE_MAX_EXTRACT_BYTES=17179869184

# GitLab policy.
GITLAB_PROTECTED_BRANCHES=main,master
GITLAB_REGISTRY_CACHE_TTL_SECONDS=60

# Infisical bootstrap shared only by runtimes that resolve secrets.
INFISICAL_HOST=https://secrets.koba-nexus.ru
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=prod
INFISICAL_BASE_PATH=/
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_VERIFY_TLS=true
INFISICAL_CA_FILE=

# Optional internal service URL overrides. Normally Docker DNS defaults are used.
GITHUB_MCP_URL=http://github-mcp:8000/mcp
GITLAB_MCP_URL=http://gitlab-mcp:8000/mcp
FILES_MCP_URL=http://files-mcp:8000/mcp
HTTP_MCP_URL=http://http-mcp:8000/mcp
ANALYSIS_MCP_URL=http://analysis-mcp:8000/mcp
GHIDRA_MCP_URL=http://ghidra-mcp:8081/mcp
